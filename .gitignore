.env
.env.local
.stack/
*.log
.DS_Store
.claude

# Generated by ./stack and tailnet-poller. Kept out of homepage/config/ so
# the config directory stays hand-edit-only.
homepage/.generated/

# Legacy path — services.yaml used to live in homepage/config/. New installs
# write to homepage/.generated/services.yaml instead. Existing files here
# are harmless leftovers.
homepage/config/services.yaml

# Homepage auto-creates these as empty templates on first boot. They are
# user-customizable but not used by this stack — keep them out of git so
# every checkout doesn't carry stub files specific to one user's machine.
homepage/config/kubernetes.yaml
homepage/config/proxmox.yaml
homepage/config/custom.css
homepage/config/custom.js
homepage/config/logs/
