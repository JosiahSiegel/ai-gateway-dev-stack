#!/usr/bin/env bash
# ai-gateway-dev-stack — one-command orchestrator.
#
#   ./stack up        Bring everything up (manifest + postgres + proxy)
#   ./stack down      Stop everything
#   ./stack restart   Restart everything
#   ./stack status    Show what's running
#   ./stack logs      Tail logs from manifest + proxy
#   ./stack pull      Pull latest submodules + Docker images
#   ./stack opencode  Print an opencode.json snippet pre-wired to this stack
#   ./stack claudcode Print Claude Code settings instructions for this stack
#
# Assumptions: Docker (or Docker Desktop with WSL integration), Node.js, and
# Bash. Works in WSL, macOS, Linux, and Git Bash on Windows.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

STATE_DIR="$ROOT/.stack"
PROXY_PID_FILE="$STATE_DIR/proxy.pid"
PROXY_LOG="$STATE_DIR/proxy.log"
ENV_FILE="$ROOT/.env"
ENV_EXAMPLE="$ROOT/.env.example"

COMPOSE_FILES=(-f manifest-local/docker-compose.yml -f compose.yml)
COMPOSE=(docker compose --project-directory "$ROOT" --env-file "$ENV_FILE" "${COMPOSE_FILES[@]}")

mkdir -p "$STATE_DIR"

# --- helpers ---------------------------------------------------------------

log()  { printf '\033[1;36m[stack]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[stack]\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m[stack]\033[0m %s\n' "$*" >&2; exit 1; }

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

ensure_submodules() {
  if [ ! -f "$ROOT/manifest-local/docker-compose.yml" ] || [ ! -f "$ROOT/provider-proxy/provider-proxy.js" ]; then
    log "initializing submodules"
    git submodule update --init --recursive
  fi
}

ensure_env() {
  if [ ! -f "$ENV_FILE" ]; then
    [ -f "$ENV_EXAMPLE" ] || die ".env.example missing — repo is broken"
    cp "$ENV_EXAMPLE" "$ENV_FILE"
    log "created .env from .env.example"
  fi

  # Auto-generate BETTER_AUTH_SECRET if blank — required by manifest-local.
  if ! grep -E '^BETTER_AUTH_SECRET=.+' "$ENV_FILE" >/dev/null; then
    local secret
    secret="$(openssl rand -hex 32 2>/dev/null || node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")"
    [ -n "$secret" ] || die "could not generate BETTER_AUTH_SECRET (need openssl or node)"
    # portable in-place replace (sed -i differs across BSD/GNU)
    awk -v s="$secret" '
      BEGIN{done=0}
      /^BETTER_AUTH_SECRET=/{print "BETTER_AUTH_SECRET=" s; done=1; next}
      {print}
      END{if(!done) print "BETTER_AUTH_SECRET=" s}
    ' "$ENV_FILE" > "$ENV_FILE.tmp" && mv "$ENV_FILE.tmp" "$ENV_FILE"
    log "generated BETTER_AUTH_SECRET in .env"
  fi

  # Same idea for MANIFEST_ENCRYPTION_KEY (recommended but optional).
  if ! grep -E '^MANIFEST_ENCRYPTION_KEY=.+' "$ENV_FILE" >/dev/null; then
    local key
    key="$(openssl rand -hex 32 2>/dev/null || node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")"
    if [ -n "$key" ]; then
      awk -v s="$key" '
        BEGIN{done=0}
        /^MANIFEST_ENCRYPTION_KEY=/{print "MANIFEST_ENCRYPTION_KEY=" s; done=1; next}
        {print}
        END{if(!done) print "MANIFEST_ENCRYPTION_KEY=" s}
      ' "$ENV_FILE" > "$ENV_FILE.tmp" && mv "$ENV_FILE.tmp" "$ENV_FILE"
      log "generated MANIFEST_ENCRYPTION_KEY in .env"
    fi
  fi
}

# Read a var from .env (treats blank/unset the same). Strips trailing CR so
# Windows-edited .env files work in WSL/Git Bash.
env_get() {
  local key="$1"
  awk -F= -v k="$key" '
    {sub(/\r$/,"")}
    $1==k {sub(/^[^=]*=/,""); print; exit}
  ' "$ENV_FILE"
}

manifest_base_url() {
  local base_url port
  base_url="$(env_get CLAUDE_CODE_MANIFEST_URL)"
  if [ -z "$base_url" ]; then
    base_url="$(env_get BETTER_AUTH_URL)"
  fi
  if [ -z "$base_url" ] || [[ "$base_url" == http://localhost:* ]]; then
    port="$(env_get PORT)"; port="${port:-2099}"
    base_url="http://localhost:${port}/"
  fi
  case "$base_url" in */) ;; *) base_url="${base_url}/" ;; esac
  printf '%s\n' "$base_url"
}

manifest_openai_base_url() {
  local base_url
  base_url="${1%/}"
  case "$base_url" in
    */v1) printf '%s\n' "$base_url" ;;
    *) printf '%s/v1\n' "$base_url" ;;
  esac
}

# --- proxy lifecycle (host process, not Docker) ----------------------------

proxy_running() {
  [ -f "$PROXY_PID_FILE" ] || return 1
  local pid
  pid="$(cat "$PROXY_PID_FILE" 2>/dev/null || true)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

proxy_start() {
  if proxy_running; then
    log "provider-proxy already running (pid $(cat "$PROXY_PID_FILE"))"
    return 0
  fi

  require_cmd node

  local target_host targets
  target_host="$(env_get PROXY_TARGET_HOST || true)"
  targets="$(env_get PROXY_TARGETS || true)"

  if [ -z "$target_host" ] && [ -z "$targets" ]; then
    warn "no PROXY_TARGET_HOST or PROXY_TARGETS configured — skipping provider-proxy"
    warn "edit .env to enable the proxy; then run ./stack restart"
    return 0
  fi

  log "starting provider-proxy on 127.0.0.1:$(env_get PROXY_PORT || echo 9997)"

  # Build env for the child process. Variable names match provider-proxy.js.
  (
    set -a
    PROXY_PORT="$(env_get PROXY_PORT)"
    TARGET_HOST="$target_host"
    TARGET_PROTOCOL="$(env_get PROXY_TARGET_PROTOCOL)"
    TARGET_PORT="$(env_get PROXY_TARGET_PORT)"
    TARGETS="$targets"
    USER_AGENT="$(env_get PROXY_USER_AGENT)"
    EXTRA_HEADERS="$(env_get PROXY_EXTRA_HEADERS)"
    DEBUG_PROXY="$(env_get PROXY_DEBUG)"
    DEBUG_BODY="$(env_get PROXY_DEBUG_BODY)"
    set +a

    nohup node "$ROOT/provider-proxy/provider-proxy.js" >>"$PROXY_LOG" 2>&1 &
    echo $! >"$PROXY_PID_FILE"
  )

  sleep 1
  if proxy_running; then
    log "provider-proxy pid $(cat "$PROXY_PID_FILE"), logs at .stack/proxy.log"
  else
    die "provider-proxy failed to start — check .stack/proxy.log"
  fi
}

proxy_stop() {
  if proxy_running; then
    local pid
    pid="$(cat "$PROXY_PID_FILE")"
    log "stopping provider-proxy (pid $pid)"
    kill "$pid" 2>/dev/null || true
    sleep 0.5
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$PROXY_PID_FILE"
}

# --- commands --------------------------------------------------------------

cmd_up() {
  require_cmd docker
  ensure_submodules
  ensure_env

  log "starting manifest + postgres (docker compose)"
  "${COMPOSE[@]}" up -d

  proxy_start

  local port proxy_port
  port="$(env_get PORT)"; port="${port:-2099}"
  proxy_port="$(env_get PROXY_PORT)"; proxy_port="${proxy_port:-9997}"

  cat <<EOF

  ai-gateway-dev-stack is up.

    Manifest dashboard:  http://localhost:${port}
    Provider proxy:      http://127.0.0.1:${proxy_port}
    Logs:                ./stack logs
    Tear down:           ./stack down
    OpenCode snippet:    ./stack opencode
    Claude Code setup:   ./stack claudcode

  First-run: open the dashboard, complete the /setup wizard, then add LLM
  providers that point at the proxy, e.g.:

    http://host.docker.internal:${proxy_port}/openai/v1
    http://host.docker.internal:${proxy_port}/kimi/v1

EOF
}

cmd_down() {
  proxy_stop
  if command -v docker >/dev/null 2>&1; then
    "${COMPOSE[@]}" down
  fi
}

cmd_restart() { cmd_down; cmd_up; }

cmd_status() {
  if proxy_running; then
    log "provider-proxy: running (pid $(cat "$PROXY_PID_FILE"))"
  else
    log "provider-proxy: stopped"
  fi
  "${COMPOSE[@]}" ps
}

cmd_logs() {
  log "tailing manifest + proxy logs (ctrl-c to stop)"
  if proxy_running; then
    tail -F "$PROXY_LOG" &
    local tail_pid=$!
    trap 'kill $tail_pid 2>/dev/null || true' EXIT INT TERM
  fi
  "${COMPOSE[@]}" logs -f
}

cmd_pull() {
  log "updating submodules"
  git submodule update --remote --merge
  log "pulling docker images"
  "${COMPOSE[@]}" pull
}

cmd_opencode() {
  local proxy_port base_url openai_base_url model
  proxy_port="$(env_get PROXY_PORT)"; proxy_port="${proxy_port:-9997}"
  base_url="$(manifest_base_url)"
  openai_base_url="$(manifest_openai_base_url "$base_url")"
  model="$(env_get CLAUDE_CODE_MODEL)"
  model="${model:-manifest/auto}"
  cat <<EOF
# Drop into ~/.config/opencode/opencode.json (or this project's opencode.json).
# Manifest is the recommended entry point — it gives you logging, usage, and
# rate limiting. The direct proxy entries are useful for debugging.

{
  "\$schema": "https://opencode.ai/config.json",
  "provider": {
    "manifest": {
      "name": "Manifest",
      "options": {
        "npm": "@ai-sdk/openai-compatible",
        "baseURL": "${openai_base_url}"
      },
      "models": { "${model#manifest/}": { "name": "Manifest Auto" } }
    },
    "proxy-openai": {
      "name": "Proxy -> OpenAI",
      "options": {
        "npm": "@ai-sdk/openai-compatible",
        "baseURL": "http://127.0.0.1:${proxy_port}/openai/v1"
      }
    },
    "proxy-kimi": {
      "name": "Proxy -> Kimi",
      "options": {
        "npm": "@ai-sdk/openai-compatible",
        "baseURL": "http://127.0.0.1:${proxy_port}/kimi/v1"
      }
    }
  }
}
EOF
}

cmd_claudcode() {
  local base_url model
  base_url="$(manifest_base_url)"

  model="$(env_get CLAUDE_CODE_MODEL)"
  model="${model:-manifest/auto}"

  cat <<EOF
# Claude Code -> Manifest setup
#
# This mirrors the pattern in manifest-local/.claude/settings.json:
#   ANTHROPIC_BASE_URL points at Manifest
#   ANTHROPIC_CUSTOM_MODEL_OPTION selects Manifest's routed model
#
# 1) Create a project settings file:
#
#   mkdir -p .claude
#   cat > .claude/settings.json <<'JSON'
{
  "\$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_BASE_URL": "${base_url}",
    "ENABLE_TOOL_SEARCH": "true",
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "${model}",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME": "Manifest Auto",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION": "Routed through Manifest",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "32000",
    "MAX_THINKING_TOKENS": "10000"
  },
  "effortLevel": "medium"
}
JSON
#
# 2) Add your Manifest API token locally only. Do NOT commit this file:
#
#   cat > .claude/settings.local.json <<'JSON'
{
  "\$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "mnfst_REPLACE_WITH_YOUR_MANIFEST_TOKEN"
  }
}
JSON
#
# 3) Ensure .claude/settings.local.json is ignored, then restart Claude Code.
#
# If using the Tailscale/public Manifest URL instead of localhost, set this in .env:
#   CLAUDE_CODE_MANIFEST_URL=https://your-manifest-host/
#
# The token comes from Manifest. In your manual setup this lived in
# manifest-local/.claude/settings.local.json and was intentionally local-only.
EOF
}

case "${1:-up}" in
  up)        cmd_up ;;
  down)      cmd_down ;;
  restart)   cmd_restart ;;
  status|ps) cmd_status ;;
  logs)      cmd_logs ;;
  pull)      cmd_pull ;;
  opencode)  cmd_opencode ;;
  claudcode|claudecode|claude-code|claude_code) cmd_claudcode ;;
  -h|--help|help)
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    die "unknown command: $1 (try ./stack help)"
    ;;
esac
