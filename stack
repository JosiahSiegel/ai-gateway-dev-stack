#!/usr/bin/env bash
# ai-gateway-dev-stack — one-command orchestrator.
#
#   ./stack up        Bring everything up (manifest + postgres + proxy)
#   ./stack down      Stop everything
#   ./stack restart           Restart everything
#   ./stack restart <svc>...  Restart only the given compose service(s)
#   ./stack status    Show what's running
#   ./stack logs      Tail logs from manifest + proxy
#   ./stack pull      Pull latest submodules + Docker images
#   ./stack opencode  Print an opencode.json snippet pre-wired to this stack
#   ./stack claude    Print Claude Code settings (.claude/*) pre-wired to this stack
#   ./stack expose    Configure Tailscale Serve/Funnel + .env (interactive)
#   ./stack unexpose  Remove this node's Tailscale Serve/Funnel (idempotent)
#   ./stack autostart enable|disable|status   Install/remove a systemd unit so
#                     the stack comes back on host reboot (Linux + systemd only)
#
# Assumptions: Docker (or Docker Desktop with WSL integration), Node.js, and
# Bash. Works in WSL, macOS, Linux, and Git Bash on Windows.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

STATE_DIR="$ROOT/.stack"
PROXY_PID_FILE="$STATE_DIR/proxy.pid"
PROXY_LOG="$STATE_DIR/proxy.log"
ENV_FILE="$ROOT/.env"
ENV_EXAMPLE="$ROOT/.env.example"
ROUTES_FILE="$ROOT/proxy.routes.json"
ROUTES_EXAMPLE="$ROOT/proxy.routes.example.json"
HOMEPAGE_GENERATED_DIR="$ROOT/homepage/.generated"
HOMEPAGE_GENERATED_SERVICES="$HOMEPAGE_GENERATED_DIR/services.yaml"

COMPOSE_FILES=(-f manifest-local/docker-compose.yml -f compose.yml)

mkdir -p "$STATE_DIR" "$HOMEPAGE_GENERATED_DIR"

# Build the compose command on demand so we can conditionally inject
# --profile flags (e.g. enable the tailnet-poller when TAILSCALE_API_KEY is set).
# True when the tailnet-poller has credentials to run — either a long-lived
# API key or an OAuth client (id + secret).
tailnet_enabled() {
  [ -f "$ENV_FILE" ] || return 1
  if [ -n "$(env_get TAILSCALE_API_KEY)" ]; then
    return 0
  fi
  if [ -n "$(env_get TAILSCALE_OAUTH_CLIENT_ID)" ] && [ -n "$(env_get TAILSCALE_OAUTH_CLIENT_SECRET)" ]; then
    return 0
  fi
  return 1
}

compose() {
  local profiles=()
  if tailnet_enabled; then
    profiles+=(--profile tailnet)
  fi
  docker compose --project-directory "$ROOT" --env-file "$ENV_FILE" \
    "${COMPOSE_FILES[@]}" "${profiles[@]}" "$@"
}

# --- helpers ---------------------------------------------------------------

log()  { printf '\033[1;36m[stack]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[stack]\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m[stack]\033[0m %s\n' "$*" >&2; exit 1; }

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

ensure_submodules() {
  if [ ! -f "$ROOT/manifest-local/docker-compose.yml" ] || [ ! -f "$ROOT/provider-proxy/provider-proxy.js" ]; then
    log "initializing submodules"
    git submodule update --init --recursive
  fi
}

ensure_env() {
  if [ ! -f "$ENV_FILE" ]; then
    [ -f "$ENV_EXAMPLE" ] || die ".env.example missing — repo is broken"
    cp "$ENV_EXAMPLE" "$ENV_FILE"
    log "created .env from .env.example"
  fi

  # Auto-generate BETTER_AUTH_SECRET if blank — required by manifest-local.
  if ! grep -E '^BETTER_AUTH_SECRET=.+' "$ENV_FILE" >/dev/null; then
    local secret
    secret="$(openssl rand -hex 32 2>/dev/null || node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")"
    [ -n "$secret" ] || die "could not generate BETTER_AUTH_SECRET (need openssl or node)"
    # portable in-place replace (sed -i differs across BSD/GNU)
    awk -v s="$secret" '
      BEGIN{done=0}
      /^BETTER_AUTH_SECRET=/{print "BETTER_AUTH_SECRET=" s; done=1; next}
      {print}
      END{if(!done) print "BETTER_AUTH_SECRET=" s}
    ' "$ENV_FILE" > "$ENV_FILE.tmp" && mv "$ENV_FILE.tmp" "$ENV_FILE"
    log "generated BETTER_AUTH_SECRET in .env"
  fi

  # Same idea for MANIFEST_ENCRYPTION_KEY (recommended but optional).
  if ! grep -E '^MANIFEST_ENCRYPTION_KEY=.+' "$ENV_FILE" >/dev/null; then
    local key
    key="$(openssl rand -hex 32 2>/dev/null || node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")"
    if [ -n "$key" ]; then
      awk -v s="$key" '
        BEGIN{done=0}
        /^MANIFEST_ENCRYPTION_KEY=/{print "MANIFEST_ENCRYPTION_KEY=" s; done=1; next}
        {print}
        END{if(!done) print "MANIFEST_ENCRYPTION_KEY=" s}
      ' "$ENV_FILE" > "$ENV_FILE.tmp" && mv "$ENV_FILE.tmp" "$ENV_FILE"
      log "generated MANIFEST_ENCRYPTION_KEY in .env"
    fi
  fi
}

# Seed homepage/.generated/services.yaml from the user-editable template on
# first boot. compose.yml bind-mounts this single file into the homepage
# container at /app/config/services.yaml — keeping generated output out of
# the hand-edited homepage/config/ directory. When the tailnet-poller runs
# it overwrites this file every poll; homepage needs *something* to load
# when the poller is disabled, hence the seed.
ensure_homepage_seed() {
  local tpl="$ROOT/homepage/services.template.yaml"
  if [ ! -f "$HOMEPAGE_GENERATED_SERVICES" ]; then
    if [ -f "$tpl" ]; then
      cp "$tpl" "$HOMEPAGE_GENERATED_SERVICES"
      log "seeded homepage/.generated/services.yaml from template"
    else
      # compose.yml bind-mounts this file into the homepage container; if it
      # doesn't exist before `compose up`, Docker will silently create a
      # *directory* at that path and homepage will fail to parse the YAML.
      : > "$HOMEPAGE_GENERATED_SERVICES"
      warn "services.template.yaml missing; created empty homepage/.generated/services.yaml"
    fi
  fi

  # One-time migration nudge: the old path was homepage/config/services.yaml.
  # If a leftover sits there, point it out so the user can clean up.
  if [ -f "$ROOT/homepage/config/services.yaml" ]; then
    warn "homepage/config/services.yaml is no longer used (moved to homepage/.generated/services.yaml). You can delete the old file."
  fi
}

# Seed proxy.routes.json from the example on first boot, AND migrate any
# legacy PROXY_TARGETS=... value still hanging out in .env. PROXY_TARGETS in
# .env is no longer read — proxy.routes.json is the single source of truth.
ensure_routes() {
  if [ -f "$ROUTES_FILE" ]; then
    return 0
  fi

  local legacy=""
  [ -f "$ENV_FILE" ] && legacy="$(env_get PROXY_TARGETS)"
  if [ -n "$legacy" ]; then
    printf '%s\n' "$legacy" > "$ROUTES_FILE"
    log "migrated PROXY_TARGETS from .env into proxy.routes.json"
    warn "PROXY_TARGETS in .env is no longer read — you can delete that line."
    return 0
  fi

  if [ -f "$ROUTES_EXAMPLE" ]; then
    cp "$ROUTES_EXAMPLE" "$ROUTES_FILE"
    log "created proxy.routes.json from proxy.routes.example.json"
  fi
}

# Read a var from .env (treats blank/unset the same). Strips trailing CR so
# Windows-edited .env files work in WSL/Git Bash.
env_get() {
  local key="$1"
  awk -F= -v k="$key" '
    {sub(/\r$/,"")}
    $1==k {sub(/^[^=]*=/,""); print; exit}
  ' "$ENV_FILE"
}

# Write KEY=value to .env. If the key already exists (even commented), the
# existing line is replaced; otherwise a new line is appended. We use awk +
# tempfile because sed -i differs on BSD vs GNU. The value is written
# verbatim (no quoting added) — caller must supply a shell-safe value.
env_set() {
  local key="$1" val="$2"
  [ -f "$ENV_FILE" ] || die ".env missing — run ./stack up first"
  awk -v k="$key" -v v="$val" '
    BEGIN{done=0}
    {sub(/\r$/,"")}
    # Match either "KEY=..." or "# KEY=..." (commented-out template line)
    $0 ~ "^#? *" k "=" {
      if (!done) { print k "=" v; done=1 }
      next
    }
    {print}
    END{if(!done) print k "=" v}
  ' "$ENV_FILE" > "$ENV_FILE.tmp" && mv "$ENV_FILE.tmp" "$ENV_FILE"
}

# --- tailscale helpers (used by ./stack expose / unexpose) ------------------

# Print the tailnet's MagicDNS suffix (e.g. tailcad1ad.ts.net), or empty.
tailscale_domain() {
  command -v tailscale >/dev/null 2>&1 || return 1
  tailscale status --json 2>/dev/null | node -e '
    let s=""; process.stdin.on("data",d=>s+=d).on("end",()=>{
      try { const j=JSON.parse(s);
        const d = j.MagicDNSSuffix || (j.CurrentTailnet && j.CurrentTailnet.MagicDNSSuffix);
        if (d) process.stdout.write(d);
      } catch(e) {}
    });
  ' 2>/dev/null
}

# Print this node's short hostname as Tailscale sees it.
tailscale_hostname() {
  command -v tailscale >/dev/null 2>&1 || return 1
  tailscale status --json 2>/dev/null | node -e '
    let s=""; process.stdin.on("data",d=>s+=d).on("end",()=>{
      try { const j=JSON.parse(s);
        if (j.Self && j.Self.HostName) process.stdout.write(j.Self.HostName);
      } catch(e) {}
    });
  ' 2>/dev/null
}

# Best-effort `tailscale ... off` — never fails the script.
ts_off() {
  sudo tailscale "$@" 2>/dev/null || tailscale "$@" 2>/dev/null || true
}

# Yes/no prompt with default. Honors --yes / NONINTERACTIVE=1 (auto-accepts default).
ask_yn() {
  local prompt="$1" default="${2:-y}" reply
  if [ "${NONINTERACTIVE:-0}" = "1" ]; then
    [ "$default" = "y" ] && return 0 || return 1
  fi
  read -r -p "$prompt " reply
  reply="${reply:-$default}"
  case "$reply" in [Yy]*) return 0 ;; *) return 1 ;; esac
}

manifest_base_url() {
  local base_url port
  base_url="$(env_get CLAUDE_CODE_MANIFEST_URL)"
  if [ -z "$base_url" ]; then
    base_url="$(env_get BETTER_AUTH_URL)"
  fi
  if [ -z "$base_url" ] || [[ "$base_url" == http://localhost:* ]]; then
    port="$(env_get PORT)"; port="${port:-2099}"
    base_url="http://localhost:${port}/"
  fi
  case "$base_url" in */) ;; *) base_url="${base_url}/" ;; esac
  printf '%s\n' "$base_url"
}

manifest_openai_base_url() {
  local base_url
  base_url="${1%/}"
  case "$base_url" in
    */v1) printf '%s\n' "$base_url" ;;
    *) printf '%s/v1\n' "$base_url" ;;
  esac
}

# --- proxy lifecycle (host process, not Docker) ----------------------------

proxy_running() {
  [ -f "$PROXY_PID_FILE" ] || return 1
  local pid
  pid="$(cat "$PROXY_PID_FILE" 2>/dev/null || true)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

proxy_start() {
  if proxy_running; then
    log "provider-proxy already running (pid $(cat "$PROXY_PID_FILE"))"
    return 0
  fi

  require_cmd node

  local target_host targets=""
  target_host="$(env_get PROXY_TARGET_HOST || true)"
  if [ -f "$ROUTES_FILE" ]; then
    # Validate JSON early so we surface a clearer error than the proxy gives
    # if the file is malformed.
    if ! node -e 'JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"))' "$ROUTES_FILE" 2>/dev/null; then
      die "proxy.routes.json is not valid JSON — fix it or delete it to re-seed from proxy.routes.example.json"
    fi
    targets="$(cat "$ROUTES_FILE")"
  fi

  if [ -z "$target_host" ] && [ -z "$targets" ]; then
    warn "no PROXY_TARGET_HOST set and no proxy.routes.json — skipping provider-proxy"
    warn "copy proxy.routes.example.json -> proxy.routes.json (or set PROXY_TARGET_HOST in .env), then ./stack restart"
    return 0
  fi

  local proxy_bind
  proxy_bind="$(env_get PROXY_BIND)"; proxy_bind="${proxy_bind:-127.0.0.1}"
  log "starting provider-proxy on ${proxy_bind}:$(env_get PROXY_PORT || echo 9997)"
  if [ "$proxy_bind" != "127.0.0.1" ]; then
    warn "PROXY_BIND=${proxy_bind} — proxy is not loopback-only; the host firewall is the only barrier"
  fi

  # Build env for the child process. Variable names match provider-proxy.js.
  # Assignment and export are split so shellcheck (SC2155) sees the env_get
  # exit status — the export itself can't mask it.
  (
    PROXY_PORT="$(env_get PROXY_PORT)"
    PROXY_BIND="$proxy_bind"
    TARGET_PROTOCOL="$(env_get PROXY_TARGET_PROTOCOL)"
    TARGET_PORT="$(env_get PROXY_TARGET_PORT)"
    USER_AGENT="$(env_get PROXY_USER_AGENT)"
    EXTRA_HEADERS="$(env_get PROXY_EXTRA_HEADERS)"
    DEBUG_PROXY="$(env_get PROXY_DEBUG)"
    DEBUG_BODY="$(env_get PROXY_DEBUG_BODY)"
    TARGET_HOST="$target_host"
    TARGETS="$targets"
    export PROXY_PORT PROXY_BIND TARGET_HOST TARGET_PROTOCOL TARGET_PORT TARGETS \
      USER_AGENT EXTRA_HEADERS DEBUG_PROXY DEBUG_BODY

    nohup node "$ROOT/provider-proxy/provider-proxy.js" >>"$PROXY_LOG" 2>&1 &
    echo $! >"$PROXY_PID_FILE"
  )

  sleep 1
  if proxy_running; then
    log "provider-proxy pid $(cat "$PROXY_PID_FILE"), logs at .stack/proxy.log"
  else
    die "provider-proxy failed to start — check .stack/proxy.log"
  fi
}

proxy_stop() {
  if proxy_running; then
    local pid
    pid="$(cat "$PROXY_PID_FILE")"
    log "stopping provider-proxy (pid $pid)"
    kill "$pid" 2>/dev/null || true
    sleep 0.5
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$PROXY_PID_FILE"
}

# --- commands --------------------------------------------------------------

cmd_up() {
  require_cmd docker
  ensure_submodules
  ensure_env
  ensure_routes
  ensure_homepage_seed

  log "starting manifest + postgres + homepage (docker compose)"
  compose up -d

  proxy_start

  local port proxy_port proxy_bind homepage_port tailnet_msg
  port="$(env_get PORT)"; port="${port:-2099}"
  proxy_port="$(env_get PROXY_PORT)"; proxy_port="${proxy_port:-9997}"
  proxy_bind="$(env_get PROXY_BIND)"; proxy_bind="${proxy_bind:-127.0.0.1}"
  homepage_port="$(env_get HOMEPAGE_PORT)"; homepage_port="${homepage_port:-2100}"
  if tailnet_enabled; then
    tailnet_msg="enabled (tailnet-poller running)"
  else
    tailnet_msg="disabled (set TAILSCALE_API_KEY or OAuth client in .env to enable)"
  fi

  cat <<EOF

  ai-gateway-dev-stack is up.

    Homepage dashboard:  http://localhost:${homepage_port}
    Manifest dashboard:  http://localhost:${port}
    Provider proxy:      http://${proxy_bind}:${proxy_port}
    Tailnet discovery:   ${tailnet_msg}
    Logs:                ./stack logs
    Tear down:           ./stack down
    OpenCode snippet:    ./stack opencode
    Claude Code setup:   ./stack claude

  First-run: open the Manifest dashboard, complete the /setup wizard, then
  add LLM providers that point at the proxy, e.g.:

    http://host.docker.internal:${proxy_port}/openai/v1
    http://host.docker.internal:${proxy_port}/kimi/coding/v1

EOF
}

cmd_down() {
  proxy_stop
  if command -v docker >/dev/null 2>&1; then
    compose down
  fi
}

cmd_restart() {
  # `./stack restart` with no args: full down + up (rebuilds host proxy too).
  # `./stack restart <service> [<service>...]`: recreate those compose
  # services. We use `up -d --force-recreate` instead of `restart` because
  # `restart` only re-runs the existing container — it does NOT re-read
  # labels, env vars, or volume specs from compose.yml or .env, so changes
  # to e.g. homepage.* labels wouldn't take effect.
  if [ "$#" -eq 0 ]; then
    cmd_down; cmd_up
  else
    require_cmd docker
    log "recreating compose services: $*"
    compose up -d --force-recreate --no-deps "$@"
  fi
}

cmd_status() {
  if proxy_running; then
    log "provider-proxy: running (pid $(cat "$PROXY_PID_FILE"))"
  else
    log "provider-proxy: stopped"
  fi
  compose ps
}

cmd_logs() {
  log "tailing manifest + proxy logs (ctrl-c to stop)"
  if proxy_running; then
    tail -F "$PROXY_LOG" &
    local tail_pid=$!
    trap 'kill $tail_pid 2>/dev/null || true' EXIT INT TERM
  fi
  compose logs -f
}

cmd_pull() {
  log "updating submodules"
  git submodule update --remote --merge
  log "pulling docker images"
  compose pull
}

# Both `opencode` and `claude` emit a single parseable JSON document on
# stdout; usage prose goes to stderr. That keeps redirection clean:
#   ./stack opencode > ~/.config/opencode/opencode.json
#   ./stack claude   > /tmp/claude.json   # then split into .claude/*.json
cmd_opencode() {
  local proxy_port base_url openai_base_url model
  proxy_port="$(env_get PROXY_PORT)"; proxy_port="${proxy_port:-9997}"
  base_url="$(manifest_base_url)"
  openai_base_url="$(manifest_openai_base_url "$base_url")"
  model="$(env_get CLAUDE_CODE_MODEL)"
  model="${model:-manifest/auto}"

  cat >&2 <<EOF
# Drop the stdout JSON into ~/.config/opencode/opencode.json (or this
# project's opencode.json), then restart OpenCode. Manifest is the
# recommended entry point; the proxy-* entries are for debugging.
EOF

  cat <<EOF
{
  "\$schema": "https://opencode.ai/config.json",
  "provider": {
    "manifest": {
      "name": "Manifest",
      "options": {
        "npm": "@ai-sdk/openai-compatible",
        "baseURL": "${openai_base_url}"
      },
      "models": { "${model#manifest/}": { "name": "Manifest Auto" } }
    },
    "proxy-openai": {
      "name": "Proxy -> OpenAI",
      "options": {
        "npm": "@ai-sdk/openai-compatible",
        "baseURL": "http://127.0.0.1:${proxy_port}/openai/v1"
      }
    },
    "proxy-kimi": {
      "name": "Proxy -> Kimi",
      "options": {
        "npm": "@ai-sdk/openai-compatible",
        "baseURL": "http://127.0.0.1:${proxy_port}/kimi/coding/v1"
      }
    }
  }
}
EOF
}

cmd_claude() {
  local base_url model
  base_url="$(manifest_base_url)"
  model="$(env_get CLAUDE_CODE_MODEL)"
  model="${model:-manifest/auto}"

  cat >&2 <<EOF
# Claude Code -> Manifest setup.
#
# stdout is a JSON object with two keys; each is the contents of one file:
#   .settings        -> .claude/settings.json         (commit this)
#   .settings_local  -> .claude/settings.local.json   (DO NOT commit — token)
#
# Split with jq:
#   mkdir -p .claude
#   ./stack claude | jq .settings       > .claude/settings.json
#   ./stack claude | jq .settings_local > .claude/settings.local.json
#   # then edit .claude/settings.local.json and replace the token placeholder.
#
# If using the Tailscale/public Manifest URL instead of localhost, set
# CLAUDE_CODE_MANIFEST_URL=https://your-manifest-host/ in .env first.
EOF

  cat <<EOF
{
  "settings": {
    "\$schema": "https://json.schemastore.org/claude-code-settings.json",
    "env": {
      "ANTHROPIC_BASE_URL": "${base_url}",
      "ENABLE_TOOL_SEARCH": "true",
      "ANTHROPIC_CUSTOM_MODEL_OPTION": "${model}",
      "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME": "Manifest Auto",
      "ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION": "Routed through Manifest",
      "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000",
      "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75",
      "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "32000",
      "MAX_THINKING_TOKENS": "10000"
    },
    "effortLevel": "medium"
  },
  "settings_local": {
    "\$schema": "https://json.schemastore.org/claude-code-settings.json",
    "env": {
      "ANTHROPIC_AUTH_TOKEN": "mnfst_REPLACE_WITH_YOUR_MANIFEST_TOKEN"
    }
  }
}
EOF
}

# --- expose / unexpose (Tailscale Serve + Funnel automation) ---------------
#
# `./stack expose` walks you through publishing this node's Manifest +
# Homepage via Tailscale, updates .env so the apps know their public URLs,
# and restarts the affected containers. Idempotent — re-running is safe.
#
# `./stack unexpose` removes this node's Tailscale Serve/Funnel config. Run
# it on the OLD host before bringing the same Service up on a new one — two
# nodes advertising the same Service splits traffic.
#
# What this command does NOT do (Tailscale admin console is the source of
# truth for these — the script prints the exact JSON to paste):
#   - Tailnet ACL `services:` block declaring which tag owns each Service.
#   - Tailnet ACL `nodeAttrs:` granting `funnel` to this node's tag.
#   - Tagging this node (`tailscale up --advertise-tags=tag:vps`).

cmd_expose() {
  require_cmd tailscale
  require_cmd node

  # Parse flags. --yes runs non-interactively with the recommended defaults.
  local manifest_mode="" homepage_mode="" yes=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --yes|-y) yes=1 ;;
      --manifest=*) manifest_mode="${1#*=}" ;;
      --homepage=*) homepage_mode="${1#*=}" ;;
      *) die "unknown flag: $1 (try --yes, --manifest=funnel|service|off, --homepage=service|off)" ;;
    esac
    shift
  done
  [ "$yes" = "1" ] && export NONINTERACTIVE=1

  # Pre-flight: tailscale must be logged in.
  local domain hostname
  domain="$(tailscale_domain || true)"
  hostname="$(tailscale_hostname || true)"
  if [ -z "$domain" ] || [ -z "$hostname" ]; then
    die "tailscale is not logged in (or status unreadable). Run: sudo tailscale up --ssh"
  fi

  ensure_env
  local manifest_port homepage_port
  manifest_port="$(env_get PORT)"; manifest_port="${manifest_port:-2099}"
  homepage_port="$(env_get HOMEPAGE_PORT)"; homepage_port="${homepage_port:-2100}"

  # Decide what to expose. Defaults: Funnel for Manifest (public), Service
  # for Homepage (tailnet-only). Manifest can't be both Funnel AND Service
  # on the same port — pick one.
  if [ -z "$manifest_mode" ]; then
    if ask_yn "Expose Manifest publicly via Tailscale Funnel? [Y/n]" y; then
      manifest_mode=funnel
    elif ask_yn "Expose Manifest as a tailnet-only Service instead? [y/N]" n; then
      manifest_mode=service
    else
      manifest_mode=off
    fi
  fi
  if [ -z "$homepage_mode" ]; then
    if ask_yn "Expose Homepage as a tailnet Service? [Y/n]" y; then
      homepage_mode=service
    else
      homepage_mode=off
    fi
  fi

  # Derive URLs.
  local manifest_url="" homepage_url=""
  case "$manifest_mode" in
    funnel)  manifest_url="https://${hostname}.${domain}" ;;
    service) manifest_url="https://manifest.${domain}" ;;
    off)     ;;
    *) die "invalid --manifest mode: $manifest_mode" ;;
  esac
  case "$homepage_mode" in
    service) homepage_url="https://homepage.${domain}" ;;
    off)     ;;
    *) die "invalid --homepage mode: $homepage_mode" ;;
  esac

  log "tailnet domain: ${domain}"
  log "this node:      ${hostname}"
  [ -n "$manifest_url" ]  && log "manifest will be: ${manifest_url} (${manifest_mode})"
  [ -n "$homepage_url" ]  && log "homepage will be: ${homepage_url} (${homepage_mode})"

  # Apply tailscale config. We use sudo because tailscale serve/funnel
  # require root on Linux. On macOS, sudo is harmless if the user is admin.
  if [ "$manifest_mode" = "funnel" ]; then
    log "enabling Funnel for Manifest on :443 -> 127.0.0.1:${manifest_port}"
    sudo tailscale funnel --bg --https=443 "http://127.0.0.1:${manifest_port}" \
      || die "tailscale funnel failed. Likely the tailnet ACL is missing 'funnel' nodeAttr for this node's tag. See ./stack expose --help."
  elif [ "$manifest_mode" = "service" ]; then
    log "advertising Service svc:manifest on :443 -> 127.0.0.1:${manifest_port}"
    sudo tailscale serve --service=svc:manifest --bg --https=443 "http://127.0.0.1:${manifest_port}" \
      || die "tailscale serve --service=svc:manifest failed. Likely the tailnet ACL 'services' block doesn't list svc:manifest with this node's tag. See ./stack expose --help."
  fi
  if [ "$homepage_mode" = "service" ]; then
    log "advertising Service svc:homepage on :443 -> 127.0.0.1:${homepage_port}"
    sudo tailscale serve --service=svc:homepage --bg --https=443 "http://127.0.0.1:${homepage_port}" \
      || die "tailscale serve --service=svc:homepage failed. Likely the tailnet ACL 'services' block doesn't list svc:homepage with this node's tag. See ./stack expose --help."
  fi

  # Update .env so the apps believe their new origins.
  env_set TAILSCALE_TS_DOMAIN "$domain"
  if [ -n "$manifest_url" ]; then
    env_set BETTER_AUTH_URL "$manifest_url"
  fi
  if [ -n "$homepage_url" ]; then
    local allowed_hosts host_only
    host_only="${homepage_url#https://}"; host_only="${host_only#http://}"
    allowed_hosts="$(env_get HOMEPAGE_ALLOWED_HOSTS)"
    allowed_hosts="${allowed_hosts:-localhost:${homepage_port}}"
    case ",${allowed_hosts}," in
      *",${host_only},"*) ;;
      *) allowed_hosts="${allowed_hosts},${host_only}" ;;
    esac
    env_set HOMEPAGE_ALLOWED_HOSTS "$allowed_hosts"
    env_set HOMEPAGE_PUBLIC_URL "$homepage_url"
  fi
  log "updated .env"

  # Recreate the affected containers so they pick up env changes. Skipped
  # if the stack isn't running yet — `./stack up` will read the new .env.
  local manifest_cid=""
  if command -v docker >/dev/null 2>&1; then
    manifest_cid="$(compose ps -q manifest 2>/dev/null || true)"
  fi
  if [ -n "$manifest_cid" ]; then
    local svcs=()
    [ "$manifest_mode" != "off" ] && svcs+=(manifest)
    [ "$homepage_mode" != "off" ] && svcs+=(homepage)
    if [ "${#svcs[@]}" -gt 0 ]; then
      log "recreating: ${svcs[*]}"
      compose up -d --force-recreate --no-deps "${svcs[@]}"
    fi
  else
    warn "stack not running — ./stack up will pick up the new .env"
  fi

  cat <<EOF

  Exposure summary:
    Tailnet domain:   ${domain}
$( [ -n "$manifest_url" ] && printf '    Manifest URL:     %s\n' "$manifest_url" )
$( [ -n "$homepage_url" ] && printf '    Homepage URL:     %s\n' "$homepage_url" )

  Verify from another tailnet device:
$( [ -n "$manifest_url" ] && printf '    curl -sI %s | head -1\n' "$manifest_url" )
$( [ -n "$homepage_url" ] && printf '    curl -sI %s | head -1\n' "$homepage_url" )

  If 'tailscale serve/funnel' failed with a permission error, your tailnet
  ACL is missing the prerequisites. Paste this into the tailnet policy file
  (admin -> Access controls), merging with existing keys:

    "tagOwners": { "tag:vps": ["autogroup:admin"] },
    "services":  {
      "svc:manifest": { "tags": ["tag:vps"] },
      "svc:homepage": { "tags": ["tag:vps"] }
    },
    "nodeAttrs": [
      { "target": ["tag:vps"], "attr": ["funnel"] }
    ]

  Then on this node:  sudo tailscale up --ssh --advertise-tags=tag:vps

EOF
}

cmd_unexpose() {
  if ! command -v tailscale >/dev/null 2>&1; then
    warn "tailscale not installed on this host — nothing to tear down"
    return 0
  fi
  log "removing tailscale serve/funnel from this node (best-effort, idempotent)"
  ts_off funnel --https=443 off
  ts_off funnel --https=8443 off
  ts_off funnel --tcp=10000 off
  ts_off serve  --service=svc:manifest        --https=443 off
  ts_off serve  --service=svc:manifest        --https=8443 off
  ts_off serve  --service=svc:homepage        --https=443 off
  ts_off serve  --service=svc:provider-proxy  --https=443 off
  log "current serve status:"
  tailscale serve status 2>/dev/null || true
  log "current funnel status:"
  tailscale funnel status 2>/dev/null || true
  cat <<EOF

  Done. Notes:
    - .env was NOT reverted (BETTER_AUTH_URL etc) so re-running ./stack
      expose stays simple. Edit .env by hand if you need plain localhost.
    - Tailscale admin console may still list orphaned Service entries if
      no node currently advertises them. Delete from: admin -> Services.

EOF
}

# --- autostart (systemd unit so the stack survives host reboot) ------------
#
# Two reboot-survival pieces:
#   1. Containers — handled by `restart: unless-stopped` policies in
#      compose.yml (parent overlay adds them to manifest+postgres so the
#      submodule stays untouched). When the Docker daemon starts on boot,
#      it brings these back automatically. Nothing this command does.
#   2. Host provider-proxy — a plain `node` process. NOT managed by Docker,
#      so it needs systemd to come back on reboot. That's what this unit
#      handles. ExecStart calls `./stack up` which is idempotent: it
#      reconciles compose state AND starts the proxy if it isn't running.
#
# The unit is Type=oneshot + RemainAfterExit=yes so systemd treats the unit
# as "active" after `./stack up` returns. KillMode=mixed so the nohup'd
# proxy process stays alive in the unit's cgroup until ExecStop runs
# `./stack down` to take it down cleanly.

SYSTEMD_UNIT_PATH="/etc/systemd/system/ai-gateway-dev-stack.service"

require_systemctl() {
  command -v systemctl >/dev/null 2>&1 \
    || die "systemctl not found. autostart only supports Linux + systemd. On macOS, run ./stack up at login via Login Items or a launchd plist."
}

# Print the unit content (substituted with current paths) on stdout. Pure
# function — no side effects — so we can diff against the installed copy.
autostart_unit_content() {
  local user="${SUDO_USER:-${USER:-root}}"
  local node_bin
  node_bin="$(command -v node 2>/dev/null || echo /usr/bin/node)"
  cat <<EOF
[Unit]
Description=ai-gateway-dev-stack (Manifest + provider-proxy + Homepage)
Documentation=https://github.com/JosiahSiegel/ai-gateway-dev-stack
# Containers come back via Docker's restart policy when dockerd starts.
# This unit's job is the host provider-proxy — but we just call ./stack
# up so the whole world is reconciled to a known state on every boot.
After=docker.service network-online.target
Wants=network-online.target tailscaled.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Keep the nohup'd provider-proxy alive after ExecStart returns.
KillMode=mixed
TimeoutStartSec=300

WorkingDirectory=${ROOT}
User=${user}
# node lives under nvm/asdf for some users; pin PATH so the unit doesn't
# break on a minimal login shell.
Environment=PATH=$(dirname "${node_bin}"):/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

ExecStart=${ROOT}/stack up
ExecStop=${ROOT}/stack down

# Crash-restart the bring-up itself (e.g. transient docker socket flake).
Restart=on-failure
RestartSec=15s

[Install]
WantedBy=multi-user.target
EOF
}

cmd_autostart() {
  local action="${1:-status}"
  case "$action" in
    enable)
      require_systemctl
      [ "$(id -u)" -eq 0 ] || die "autostart enable needs root (use sudo). The unit must live in /etc/systemd/system/ and run as a user that can read this repo."
      log "writing ${SYSTEMD_UNIT_PATH}"
      autostart_unit_content > "$SYSTEMD_UNIT_PATH"
      systemctl daemon-reload
      log "enabling + starting ai-gateway-dev-stack.service"
      systemctl enable --now ai-gateway-dev-stack.service
      systemctl --no-pager status ai-gateway-dev-stack.service | head -20 || true
      cat <<EOF

  Autostart enabled. Verify reboot survival with:
    sudo systemctl reboot           # or just: sudo reboot
    # then after the box comes back:
    ./stack status

  Disable later with:
    sudo ./stack autostart disable

EOF
      ;;
    disable)
      require_systemctl
      [ "$(id -u)" -eq 0 ] || die "autostart disable needs root (use sudo)."
      if [ -f "$SYSTEMD_UNIT_PATH" ]; then
        log "stopping + disabling ai-gateway-dev-stack.service"
        systemctl disable --now ai-gateway-dev-stack.service || true
        rm -f "$SYSTEMD_UNIT_PATH"
        systemctl daemon-reload
        log "removed ${SYSTEMD_UNIT_PATH}"
      else
        warn "no unit at ${SYSTEMD_UNIT_PATH} — nothing to disable"
      fi
      ;;
    status)
      if ! command -v systemctl >/dev/null 2>&1; then
        warn "systemctl not present — autostart not supported on this host"
        return 0
      fi
      if [ -f "$SYSTEMD_UNIT_PATH" ]; then
        log "unit installed at ${SYSTEMD_UNIT_PATH}"
        systemctl --no-pager status ai-gateway-dev-stack.service 2>/dev/null | head -15 || true
        # Warn if the on-disk unit no longer matches what we'd generate
        # (e.g. repo moved, user changed, node path changed).
        if ! diff -q <(autostart_unit_content) "$SYSTEMD_UNIT_PATH" >/dev/null 2>&1; then
          warn "installed unit differs from current config — re-run: sudo ./stack autostart enable"
        fi
      else
        log "autostart: not installed (run: sudo ./stack autostart enable)"
      fi
      ;;
    *)
      die "usage: ./stack autostart [enable|disable|status]"
      ;;
  esac
}

subcmd="${1:-up}"
shift || true
case "$subcmd" in
  up)        cmd_up ;;
  down)      cmd_down ;;
  restart)   cmd_restart "$@" ;;
  status|ps) cmd_status ;;
  logs)      cmd_logs ;;
  pull)      cmd_pull ;;
  opencode)  cmd_opencode ;;
  claude)    cmd_claude ;;
  expose)    cmd_expose "$@" ;;
  unexpose)  cmd_unexpose ;;
  autostart) cmd_autostart "$@" ;;
  -h|--help|help)
    sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    die "unknown command: $subcmd (try ./stack help)"
    ;;
esac
