# =============================================================================
# ai-gateway-dev-stack — single .env for the whole stack
# =============================================================================
# Copy to `.env`: `cp .env.example .env`
#
# Architecture:
#   OpenCode / Claude Code  ->  Manifest (Docker, :2099)  ->  provider-proxy (host, :9999)  ->  upstream LLMs
#
# Only BETTER_AUTH_SECRET is strictly required. The `./stack up` command will
# generate one for you if you leave it blank.
# =============================================================================


# --- Manifest (forwarded to manifest-local/docker-compose.yml) ---------------

# Session signing secret. `./stack up` auto-generates one if empty.
BETTER_AUTH_SECRET=

# Separate at-rest encryption key for stored provider credentials.
# Recommended in production; optional locally. `./stack up` can auto-generate.
MANIFEST_ENCRYPTION_KEY=

# Manifest dashboard port on the host.
PORT=2099

# Public URL Manifest believes it is reachable at. Default works for localhost.
BETTER_AUTH_URL=http://localhost:2099

# Postgres password (must match DATABASE_URL if you override that too).
# POSTGRES_PASSWORD=manifest
# DATABASE_URL=postgresql://manifest:manifest@postgres:5432/manifest

# Increase if local/slow models hit timeouts (default 180000 = 3min).
PROVIDER_TIMEOUT_MS=600000

# Disable anonymous Manifest telemetry by setting to 1.
# MANIFEST_TELEMETRY_DISABLED=1

# --- OAuth (optional) --------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=


# --- provider-proxy ----------------------------------------------------------
# The proxy runs on the host (it binds 127.0.0.1 for safety). Manifest reaches
# it via host.docker.internal:${PROXY_PORT} from inside the Manifest container.

PROXY_PORT=9999

# Pick ONE of: single target via PROXY_TARGET_HOST, OR multi-target via PROXY_TARGETS.

# Single-target example: route every proxy call to one upstream.
# PROXY_TARGET_HOST=app.manifest.build
# PROXY_TARGET_PROTOCOL=https
# PROXY_TARGET_PORT=443

# Multi-target example (recommended for the gateway pattern):
# PROXY_TARGETS=[{"pathPrefix":"/openai","host":"api.openai.com"},{"pathPrefix":"/anthropic","host":"api.anthropic.com"},{"pathPrefix":"/kimi","host":"api.kimi.com","headers":{"x-app":"cli"}}]

# Optional headers injected into every upstream request.
# PROXY_USER_AGENT=claude-cli/2.1.139 (external, cli)
# PROXY_EXTRA_HEADERS={"x-app":"cli"}

# Set to 1 to log redacted upstream requests; set DEBUG_BODY=1 for full bodies.
# PROXY_DEBUG=
# PROXY_DEBUG_BODY=
