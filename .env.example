# =============================================================================
# ai-gateway-dev-stack — single .env for the whole stack
# =============================================================================
# Copy to `.env`: `cp .env.example .env`
#
# Architecture:
#   OpenCode / Claude Code  ->  Manifest (Docker, :2099)  ->  provider-proxy (host, :9999)  ->  upstream LLMs
#
# Only BETTER_AUTH_SECRET is strictly required. The `./stack up` command will
# generate one for you if you leave it blank.
# =============================================================================


# --- Manifest (forwarded to manifest-local/docker-compose.yml) ---------------

# Session signing secret. `./stack up` auto-generates one if empty.
BETTER_AUTH_SECRET=

# Separate at-rest encryption key for stored provider credentials.
# Recommended in production; optional locally. `./stack up` can auto-generate.
MANIFEST_ENCRYPTION_KEY=

# Manifest dashboard port on the host.
PORT=2099

# Public URL Manifest believes it is reachable at. Default works for localhost.
BETTER_AUTH_URL=http://localhost:2099

# Postgres password (must match DATABASE_URL if you override that too).
# POSTGRES_PASSWORD=manifest
# DATABASE_URL=postgresql://manifest:manifest@postgres:5432/manifest

# Increase if local/slow models hit timeouts (default 180000 = 3min).
PROVIDER_TIMEOUT_MS=600000

# Disable anonymous Manifest telemetry by setting to 1.
# MANIFEST_TELEMETRY_DISABLED=1

# --- Claude Code helper (optional) ------------------------------------------
# `./stack claudcode` uses these to print a ready-to-copy .claude/settings.json.
# Defaults to BETTER_AUTH_URL unless that is localhost, then http://localhost:${PORT}/.
# CLAUDE_CODE_MANIFEST_URL=https://your-manifest-host/
# CLAUDE_CODE_MODEL=manifest/auto

# --- OAuth (optional) --------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=


# --- provider-proxy ----------------------------------------------------------
# The proxy runs on the host (it binds 127.0.0.1 for safety). Manifest reaches
# it via host.docker.internal:${PROXY_PORT} from inside the Manifest container.

PROXY_PORT=9997

# Pick ONE of: single target via PROXY_TARGET_HOST, OR multi-target via PROXY_TARGETS.

# Multi-target (active default — route by path prefix). In the Manifest
# dashboard, point each provider's Base URL at one of these routes, e.g.
#   http://host.docker.internal:9997/openai/v1
#   http://host.docker.internal:9997/kimi/v1
PROXY_TARGETS=[{"pathPrefix":"/kimi","host":"api.kimi.com","headers":{"x-app":"cli"}},{"pathPrefix":"/openai","host":"api.openai.com"}]

# Single-target alternative (comment PROXY_TARGETS out if you use this).
# PROXY_TARGET_HOST=app.manifest.build
# PROXY_TARGET_PROTOCOL=https
# PROXY_TARGET_PORT=443

# User-Agent injected on every upstream request. Some providers gate access
# behind a coding-agent fingerprint; this is a safe default for that case.
PROXY_USER_AGENT=claude-cli/2.1.139 (external, cli)

# Optional extra headers injected on every upstream request.
# PROXY_EXTRA_HEADERS={"x-app":"cli"}

# Set to 1 to log redacted upstream requests; set DEBUG_BODY=1 for full bodies.
# PROXY_DEBUG=
# PROXY_DEBUG_BODY=


# --- Homepage dashboard ------------------------------------------------------
# gethomepage.dev — landing page for the stack and your tailnet services.
# Docker label auto-discovery is on by default (compose mounts the socket
# read-only); any container in this stack with `homepage.*` labels appears
# automatically.

HOMEPAGE_PORT=2100

# CSRF allow-list. Add your tailnet hostname here when reaching homepage
# from another device, comma-separated:
# HOMEPAGE_ALLOWED_HOSTS=localhost:2100,dash.tailXXXXXX.ts.net

# Public URL homepage links to itself with (e.g. on its own service tile).
# Defaults to http://localhost:${HOMEPAGE_PORT}. Set this to your tailnet
# URL when viewing homepage from another device so the self-link is right.
# HOMEPAGE_PUBLIC_URL=https://dash.tailXXXXXX.ts.net


# --- Tailnet service discovery (optional) -----------------------------------
# When TAILSCALE_API_KEY is set, ./stack starts the tailnet-poller sidecar.
# It calls the Tailscale API every TAILSCALE_POLL_INTERVAL_MS and rewrites
# homepage/config/services.yaml with a live `- Tailnet:` group of every
# device on your tailnet (filtered by tag if you set TAILSCALE_TAG_FILTER).
#
# Get an API key: https://login.tailscale.com/admin/settings/keys
# API keys max out at 90 days — you'll need to rotate this before then or
# the poller will start failing (check `docker logs tailnet-poller`).
# For a non-expiring alternative, see the OAuth client option below.
# TAILSCALE_API_KEY=tskey-api-...

# OAuth client alternative (non-expiring). Create one on the same settings
# page under the "OAuth clients" tab. Scopes:
#   devices:core:read  (required — populates the "Tailnet" group)
#   services:read      (optional — populates the "Tailscale Services" group
#                       from VIP services; skipped silently if absent)
# When BOTH are set, the poller exchanges them for short-lived access tokens
# automatically. Takes precedence over TAILSCALE_API_KEY if both are present.
# TAILSCALE_OAUTH_CLIENT_ID=
# TAILSCALE_OAUTH_CLIENT_SECRET=

# Your tailnet name. Use `-` for your default tailnet, or the org slug shown
# at the top of the admin console.
# TAILSCALE_TAILNET=-

# Your MagicDNS domain (the part after the hostname, e.g. `tailXXXXXX.ts.net`).
# Used to build https://<hostname>.<domain> links.
# TAILSCALE_TS_DOMAIN=tailXXXXXX.ts.net

# Optional: only show devices carrying this tag (e.g. `tag:web`). Empty = all.
# TAILSCALE_TAG_FILTER=

# Poll interval in ms (default 60s). Lower = fresher, higher = lighter load.
# TAILSCALE_POLL_INTERVAL_MS=60000
