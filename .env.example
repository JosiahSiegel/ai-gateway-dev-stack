# =============================================================================
# ai-gateway-dev-stack — single .env for the whole stack
# =============================================================================
# `./stack up` copies this to .env on first run and auto-generates the two
# required secrets below. Everything else is optional.
#
# The claude-proxy is a Docker compose service; OAuth runs via `./stack login`.
# See docs/migrating-from-provider-proxy.md for what to delete from old configs.
# =============================================================================

# --- Required (auto-generated by `./stack up` if blank) ---------------------

# Session signing secret.
BETTER_AUTH_SECRET=

# At-rest encryption key for stored provider credentials.
MANIFEST_ENCRYPTION_KEY=


# --- Common knobs ----------------------------------------------------------

# Manifest dashboard port.
PORT=2099

# Public URL Manifest believes it is reachable at. Default works for localhost.
BETTER_AUTH_URL=http://localhost:2099

# Manifest upstream timeout (10 minutes — local models can be slow).
PROVIDER_TIMEOUT_MS=600000

# Manifest image and per-user proxy concurrency. The custom image is built from
# https://github.com/JosiahSiegel/manifest by its GitHub Actions image workflow.
MANIFEST_IMAGE=ghcr.io/josiahsiegel/manifest:latest
CONCURRENCY_MAX=50

# --- claude-proxy (Anthropic-Messages-compatible subscription OAuth proxy) ---
# The claude-proxy service runs as a Docker compose container (see compose.yml).
# OAuth runs interactively: `./stack login` (or `docker exec -it claude-proxy
# claude-proxy login`). Token lives in the `claude-proxy-credentials` Docker
# volume, NOT in .env. The vars below tune the running service.

# Bind address inside the container. Must stay "0.0.0.0" so Manifest on the
# frontend bridge can reach the proxy by service name.
CLAUDE_PROXY_HOST=0.0.0.0

# Container-internal listen port. Manifest reaches the proxy at
# http://claude-proxy:${CLAUDE_PROXY_PORT} on the frontend network.
CLAUDE_PROXY_PORT=8080

# Standard Python log level: DEBUG, INFO, WARNING, ERROR.
CLAUDE_PROXY_LOG_LEVEL=INFO

# Bearer token clients must present on every /v1/messages call. Empty
# = trust localhost only (recommended for single-user dev). For a
# LAN/tailnet-exposed instance, set to `openssl rand -hex 32`.
CLAUDE_PROXY_AUTH_TOKEN=

# Path to the settings pin file. The image ships a default at this path;
# mount your own via the claude-proxy-config volume to override.
CLAUDE_PROXY_SETTINGS_FILE=/etc/claude-proxy/claude-settings.json

# Working directory for session transcripts. Persisted across restarts via
# the `claude-proxy-data` Docker volume.
CLAUDE_PROXY_WORK_DIR=/var/lib/claude-proxy/sessions

# Workspace roots that X-Workspace-Path headers may reference. Default [/workspaces] matches the standard harness mount.
CLAUDE_PROXY_ALLOWED_WORKSPACE_ROOTS=/workspaces

# Subscription slots. v1 default is 1 (single Pro/Max account). Multi-slot
# is wired but not load-tested; bump this once you've run load tests and
# provisioned a credentials file per slot.
CLAUDE_PROXY_NUM_SLOTS=1

# CLI version allowlist (comma-separated). Empty = no constraint. The image
# itself is pinned to 2.1.233 at build time; this is defense-in-depth at
# runtime so a stale build can't run a newer/older CLI silently.
CLAUDE_PROXY_ALLOWED_CLI_VERSIONS=2.1.233

# Per-user rate limit (token bucket). capacity = burst size,
# refill_per_second = steady-state drain rate.
CLAUDE_PROXY_USER_RATE_LIMIT_CAPACITY=60
CLAUDE_PROXY_USER_RATE_LIMIT_REFILL_PER_SECOND=1.0

# Surface tool_use blocks to API clients. v1 default is false (the CLI runs
# the tool loop internally).
CLAUDE_PROXY_ENABLE_TOOLS=false

# Structural passthrough — when true (default), every /v1/messages request
# gets a single, ephemeral ClaudeSubprocess instead of the conversation
# router's persistent slot. Skips: workspace inference, conv_key bindings,
# idempotency cache, rate limit, tool gates, retry loop. OAuth credential
# resolution is preserved via `ClaudeSubprocess._build_env()` which sets
# `CLAUDE_CONFIG_DIR` to the local credentials dir. Set false to restore
# the original router-based path.
CLAUDE_PROXY_PASSTHROUGH=true

# Backend flavor for the spawned CLI subprocess:
#   cli        — default; Claude Code agent with native tools (Read/Bash/...);
#               tools execute inside the proxy container's filesystem.
#   model_only — Anthropic-API-equivalent; the CLI is told (via
#               --disallowedTools + a system-prompt directive) NOT to execute
#               native tools and to emit client-side tool_use blocks for the
#               caller's harness to execute locally. Set this when opencode /
#               Claude Code / a custom harness implements its own tool loop.
CLAUDE_PROXY_PASSTHROUGH_MODE=cli

# JSON-structured logs (easier to ship to log aggregators; `./stack logs`
# parses either form transparently).
CLAUDE_PROXY_STRUCTURED_LOGS=true

# Path pattern for the OAuth credentials file. The `slot=N` template is
# supported for multi-slot deployments.
CLAUDE_PROXY_CREDENTIALS_PATH_TEMPLATE={home}/.claude/.credentials.json

# Model list + alias mapping. Comma-separated `api_name:cli_short_name`
# pairs. Drives both /v1/models and the body.model -> `claude --model`
# alias lookup. Empty = the proxy uses the built-in 7-model hardcoded fallback.
#
# The Claude Code CLI bundled in claude-proxy (v2.1.233) only accepts the
# short aliases `opus`, `sonnet`, `haiku`. The CLI's "what versioned
# models does my OAuth subscription have access to" answer is subscription-
# tier-specific: Pro gets the latest short-alias models (claude-opus-5,
# claude-sonnet-5, claude-haiku-4-5 as of August 2026); older 4-x versioned
# names require a different subscription tier or an ANTHROPIC_API_KEY.
#
# The left side (api_name) is what your dashboard shows; the right side
# (cli_short_name) is what the CLI receives. Pick names that reflect what
# your OAuth subscription actually serves — see the upstream `claude-proxy
# status` output to confirm.
#
# Recommended default (Pro subscription, August 2026):
CLAUDE_PROXY_MODELS=claude-opus-5:opus,claude-sonnet-5:sonnet,claude-haiku-4-5:haiku

# --- OAuth auto-refresh (submodule >= always-auth) --------------------------
# Auto-refreshes the OAuth access token when within `REFRESH_LEAD_SECONDS` of
# expiry. Requires a daemon thread inside the proxy process, so it is only
# active when this fork is built (>= the always-auth PR, submodule
# 91f5b3f). All knobs have safe defaults; uncomment to override.
#
# CLIENT_ID is the public Anthropic OAuth client baked into Claude Code 2.1.233.
# Override only if you maintain a fork of the CLI and have re-registered your
# own OAuth app. The default is what Anthropic ships and what the proxy
# authenticates against.
# CLAUDE_PROXY_OAUTH_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e
# CLAUDE_PROXY_OAUTH_TOKEN_URL=https://platform.claude.com/v1/oauth/token
# CLAUDE_PROXY_OAUTH_USER_AGENT=claude-proxy
# CLAUDE_PROXY_REFRESH_LEAD_SECONDS=300
# CLAUDE_PROXY_REFRESH_FORCE_RESPAWN=false
# CLAUDE_PROXY_SURFACE_SERVER_TOOLS=false


# --- Advanced (uncomment to use) -------------------------------------------

# Postgres password (must match DATABASE_URL if you set both).
# POSTGRES_PASSWORD=manifest
# DATABASE_URL=postgresql://manifest:manifest@postgres:5432/manifest

# Disable anonymous Manifest telemetry.
# MANIFEST_TELEMETRY_DISABLED=1

# anthropic-billing-header plugin debug capture (requires the
# manifest-with-plugins image to have been rebuilt with the plugin at
# v0.6.2+ — bump the EXTERNAL_PLUGINS_LOCAL secret on the
# JosiahSiegel/manifest-plugins repo to v0.6.2, then push any commit to
# trigger the image rebuild). Emits one
# [anthropic-billing-header:debug] console.log per /v1/messages request
# so you can see exactly which classifier signal Anthropic is rejecting.
# 1 = summary (no PII). full = also dumps serialized body.
# MANIFEST_CC_DEBUG_CAPTURE=1

# Override the URL the `./stack claude` helper bakes into its output (e.g.
# when reaching Manifest via your tailnet instead of localhost). Default is
# BETTER_AUTH_URL, falling back to http://localhost:${PORT}.
# CLAUDE_CODE_MANIFEST_URL=https://your-manifest-host/
# CLAUDE_CODE_MODEL=manifest/auto

# Manifest OAuth provider creds. Active when both ID and SECRET are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Homepage CSRF allow-list. Add your tailnet hostname here when reaching the
# dashboard from another device, comma-separated:
# HOMEPAGE_ALLOWED_HOSTS=localhost:2100,dash.tailXXXXXX.ts.net

# Public URL homepage links to itself with. Set when viewing via tailnet.
# HOMEPAGE_PUBLIC_URL=https://dash.tailXXXXXX.ts.net


# --- Tailnet service discovery (optional) ----------------------------------
# When either credential block below is set, ./stack starts the tailnet-poller
# sidecar; it appends a live `- Tailnet:` group to homepage/.generated/services.yaml
# every TAILSCALE_POLL_INTERVAL_MS. OAuth is recommended (non-expiring); API
# keys max out at 90 days. If both are set, OAuth takes precedence.

# OAuth client (recommended). Create at https://login.tailscale.com/admin/settings/oauth
# Scopes: devices:core:read (required), services:read (optional — VIP services).
# TAILSCALE_OAUTH_CLIENT_ID=
# TAILSCALE_OAUTH_CLIENT_SECRET=

# API key alternative — https://login.tailscale.com/admin/settings/keys
# TAILSCALE_API_KEY=tskey-api-...

# Your tailnet name. Use `-` for your default tailnet, or the org slug.
# TAILSCALE_TAILNET=-

# Your MagicDNS domain (e.g. tailXXXXXX.ts.net).
# `./stack expose` fills this automatically for the current host.
# TAILSCALE_TS_DOMAIN=tailXXXXXX.ts.net

# This node's Tailscale hostname. When set with TAILSCALE_TS_DOMAIN, Homepage
# gets a dynamic ssh:// tile for this host. `./stack up` auto-fills missing
# values from `tailscale status`; `./stack expose` refreshes them explicitly.
# TAILSCALE_HOSTNAME=my-vps
# HOMEPAGE_SSH_USER=root
# HOMEPAGE_SSH_TILE=1

# Restrict to devices/services carrying this tag (e.g. tag:web).
# TAILSCALE_TAG_FILTER=

# Poll interval in ms. Default 60000.
# TAILSCALE_POLL_INTERVAL_MS=60000
